from PIL import Image, ImageOps
from pathlib import Path
import shutil

# CHANGE THESE PATHS
INPUT_FOLDER = Path(r"C:\Users\YourName\Downloads\ISIC")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Downloads\ISIC_224")

# Create output folder if it doesn't exist
OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)

# Supported image formats
image_extensions = {".jpg", ".jpeg", ".png"}

processed = 0
errors = 0

for image_file in INPUT_FOLDER.iterdir():

    if image_file.suffix.lower() in image_extensions:

        try:
            # Open image
            img = Image.open(image_file).convert("RGB")

            # Resize while preserving aspect ratio
            img = ImageOps.pad(
                img,
                (224, 224),
                color=(0, 0, 0)
            )

            # Save resized image
            output_image_path = OUTPUT_FOLDER / image_file.name
            img.save(output_image_path, quality=95)

            # Copy matching JSON metadata file
            json_file = image_file.with_suffix(".json")

            if json_file.exists():
                shutil.copy2(
                    json_file,
                    OUTPUT_FOLDER / json_file.name
                )

            processed += 1

            if processed % 100 == 0:
                print(f"Processed {processed} images...")

        except Exception as e:
            errors += 1
            print(f"Error with {image_file.name}: {e}")

print("\nFinished!")
print(f"Images processed: {processed}")
print(f"Errors: {errors}")
